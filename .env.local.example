# Web push (PWA Phase 2). Generate with: node scripts/generate-vapid.js
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:transport@jkkn.ac.in

# JKKN Bug Reporter (Bug Boundary). Both are client-exposed (NEXT_PUBLIC_).
# Obtain the API key + platform URL from the JKKN Bug Reporter platform after
# registering this app. The floating reporter widget self-disables if unset.
NEXT_PUBLIC_BUG_REPORTER_API_KEY=
NEXT_PUBLIC_BUG_REPORTER_API_URL=
